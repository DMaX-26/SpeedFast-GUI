<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.speedfast.gui.VentanaListaEntregas">
  <grid id="27dc6" binding="Lista" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="b22c6">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="cf02e" class="javax.swing.JTable" binding="tblEntregas">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="6baef" class="javax.swing.JButton" binding="btnEditar">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Editar"/>
        </properties>
      </component>
      <component id="fff9e" class="javax.swing.JButton" binding="btnActualizar">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Actualizar"/>
        </properties>
      </component>
      <component id="4e161" class="javax.swing.JButton" binding="btnEliminar">
